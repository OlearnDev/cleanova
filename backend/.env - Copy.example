# Serveur
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cleanova

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Upload
MAX_UPLOAD_MB=5

# Stripe (paiement simule par defaut - remplacer par de vraies cles pour activer Stripe)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_ENABLED=false

# Email (simule par defaut - voir src/utils/mailer.js pour brancher un vrai SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=contact@cleanova.ca
